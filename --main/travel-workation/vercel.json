{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm --dir react-app install --frozen-lockfile",
  "buildCommand": "pnpm --dir react-app build",
  "outputDirectory": "react-app/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
