{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd react-app && npm install",
  "buildCommand": "cd react-app && npm run build",
  "outputDirectory": "react-dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.illowa-jeolla.cloud/api/:path*" },
    { "source": "/assets/:path*", "destination": "https://api.illowa-jeolla.cloud/assets/:path*" },
    { "source": "/uploads/:path*", "destination": "https://api.illowa-jeolla.cloud/uploads/:path*" },
    { "source": "/files/:path*", "destination": "https://api.illowa-jeolla.cloud/files/:path*" },
    { "source": "/local-images/:path*", "destination": "https://api.illowa-jeolla.cloud/local-images/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
